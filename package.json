{
  "name": "cloudblitz-enquiry-crm",
  "version": "1.0.0",
  "private": true,
  "description": "CloudBlitz Enquiry Management System CRM",
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "test": "npm test --prefix backend",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "prepare": "husky"
  },
  "keywords": [
    "crm",
    "enquiry-management",
    "express",
    "react",
    "mongodb",
    "typescript",
    "docker"
  ],
  "devDependencies": {
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
